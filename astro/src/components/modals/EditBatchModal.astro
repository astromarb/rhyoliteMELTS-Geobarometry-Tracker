<!-- EDIT BATCH MODAL -->
<div class="modal-bg" id="modal-edit-batch">
  <div class="modal eb-modal" role="dialog" aria-modal="true" tabindex="-1">
    <h2>✏ Edit Batch</h2>
    <input type="hidden" id="edit-batch-id">
    <label>Batch Name</label>
    <input id="edit-batch-name" class="m-input-lg" type="text" placeholder="Batch name...">
    <label>Subtitle / Note</label>
    <input id="edit-batch-note" class="m-input-lg" type="text" placeholder="Short description...">
    <label class="batch-color-row">
      Batch Colour
      <input id="edit-batch-color" type="color" value="#58a6ff">
    </label>
    <div class="row-end">
      <button class="btn" onclick="closeModal('modal-edit-batch')">Cancel</button>
      <button class="btn btn-primary" onclick="saveEditBatch()">Save</button>
    </div>
  </div>
</div>

<style>
  .eb-modal{max-width:440px}
  .batch-color-row{display:flex;align-items:center;gap:10px;margin-bottom:16px}
  .batch-color-row input[type="color"]{width:36px;height:28px;border:none;background:none;cursor:pointer;padding:0}
</style>
