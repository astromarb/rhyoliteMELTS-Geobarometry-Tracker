<!-- New Simulation Set -->
<div class="modal-bg" id="modal-new-simset">
  <div class="modal ns-modal" role="dialog" aria-modal="true" tabindex="-1">
    <h2>🔬 Add Run</h2>
    <p class="modal-sub">Every simulation set is associated with a parent sample. Add samples first in the <strong>🧪 Samples</strong> tab.</p>
    <div id="simset-no-samples-warn" class="ns-warn is-hidden">
      ⚠ No samples found. Please add a sample in the <strong>🧪 Samples</strong> tab first, then return here.
    </div>
    <label>Parent Sample <span class="req-star">*</span></label>
    <select id="simset-sample-sel" class="ns-mb-12"></select>
    <label>Run Type <span class="req-star">*</span></label>
    <select id="simset-run-type" onchange="syncRunType(this.value)" class="ns-mb-12">
      <option value="monte_carlo">Monte Carlo</option>
    </select>
    <div id="simset-mc-options">
      <label>Number of Simulations <span class="req-star">*</span></label>
      <div class="ns-mc-row">
        <select id="simset-total-sel" onchange="syncSimTotal(this.value)">
          <option value="50">50</option>
          <option value="100">100</option>
          <option value="200" selected>200</option>
          <option value="500">500</option>
          <option value="custom">Custom…</option>
        </select>
        <input type="number" id="simset-total-custom" placeholder="Enter number" min="1" max="9999" class="ns-custom-in is-hidden">
      </div>
    </div>
    <label>Run Name</label>
    <input type="text" id="simset-name" placeholder="Auto-filled — edit if needed">
    <div class="modal-footer">
      <button class="btn" onclick="closeModal('modal-new-simset')">Cancel</button>
      <button class="btn btn-primary" id="simset-create-btn" onclick="createSimset()">Create</button>
    </div>
  </div>
</div>

<style>
  .ns-modal{max-width:480px}
  .ns-warn{background:rgba(248,81,73,.08);border:1px solid rgba(248,81,73,.3);border-radius:6px;padding:10px;margin-bottom:12px;font-size:12px;color:#f85149}
  .ns-mb-12{margin-bottom:12px}
  .ns-mc-row{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:4px;margin-bottom:12px}
  .ns-custom-in{width:140px}
</style>
