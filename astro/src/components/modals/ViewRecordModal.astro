<!-- View Paste Record -->
<div class="modal-bg" id="modal-view-record">
  <div class="modal vr-modal" role="dialog" aria-modal="true" tabindex="-1">
    <h2>📄 Paste Record</h2>
    <p class="modal-sub">Original table as pasted. Values are stored per-cell alongside filenames.</p>
    <div class="vr-toolbar">
      <span id="vr-meta" class="vr-meta"></span>
      <button class="btn btn-sm" onclick="copyRecord()">📋 Copy</button>
    </div>
    <textarea id="vr-data" rows="12" readonly class="resize-v vr-data"></textarea>
    <div class="modal-footer">
      <button class="btn" onclick="closeModal('modal-view-record')">Close</button>
    </div>
  </div>
</div>

<style>
  .vr-modal{max-width:560px}
  .vr-toolbar{display:flex;gap:8px;margin-bottom:8px;align-items:center}
  .vr-meta{font-size:11px;color:var(--text-muted);flex:1}
  .vr-data{font-family:var(--mono);font-size:11px;background:var(--surface2);border:1px solid var(--border);border-radius:4px;color:var(--text);width:100%;box-sizing:border-box;padding:8px}
</style>
