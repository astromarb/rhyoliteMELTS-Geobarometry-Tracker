<!-- ── Bottom-LEFT utility bar (v0.20) — edit + import/export ── -->
<div id="util-bar">
  <div class="em-wrap" id="em-wrap">
    <button class="btn btn-sm em-toggle-btn" id="em-toggle" onclick="toggleEditMode()" title="Toggle edit mode" aria-label="Toggle edit mode" aria-pressed="false">＋</button>
  </div>
  <div class="util-divider"></div>
  <button class="btn btn-sm util-btn" onclick="exportData()" title="Export data as JSON" aria-label="Export data">⬇ Export</button>
  <button class="btn btn-sm util-btn" onclick="document.getElementById('import-file').click()" title="Import JSON data file" aria-label="Import data">⬆ Import</button>
</div>

<style>
  #util-bar{position:fixed;bottom:14px;left:16px;display:flex;align-items:center;gap:6px;z-index:9000;background:var(--surface);border:1px solid var(--border);border-radius:24px;padding:5px 10px;box-shadow:0 4px 18px rgba(0,0,0,.35)}
  .em-toggle-btn{border-radius:50%;width:28px;height:28px;padding:0;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:700}
  .util-divider{width:1px;height:18px;background:var(--border);margin:0 2px}
  .util-btn{font-size:11px;padding:3px 9px}
</style>
