# Copy to .env (gitignored) for local dev, or set these as Vercel project env vars.
# All three are SERVER-ONLY — never imported from client code.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # service_role key, bypasses RLS (server only!)
ADMIN_TOKEN=                            # random hex; share via the admin URL ?admin=<token>
